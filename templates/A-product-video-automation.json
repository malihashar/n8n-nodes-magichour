{
  "name": "Magic Hour — Product video automation",
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Shopify/Sheets product rows → Magic Hour Image-to-Video → Google Drive"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "When clicking ‘Test workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "mode": "list", "value": "" },
        "sheetName": { "__rl": true, "mode": "list", "value": "" },
        "options": {}
      },
      "id": "sheets",
      "name": "Product Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 0],
      "notes": "Columns: product_id, image_url, prompt (optional)"
    },
    {
      "parameters": {
        "url": "={{ $json.image_url }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "fetch",
      "name": "Fetch Product Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "imageToVideo",
        "imageSource": "binary",
        "imageBinaryProperty": "data",
        "prompt": "={{ $json.prompt || 'Subtle product motion, clean studio lighting, slow camera push-in' }}",
        "durationSeconds": 5,
        "externalId": "={{ $json.product_id }}",
        "waitForCompletion": true,
        "timeoutSeconds": 900,
        "options": { "resolution": "720p" }
      },
      "id": "mh",
      "name": "Magic Hour I2V",
      "type": "n8n-nodes-magichour.magicHour",
      "typeVersion": 1,
      "position": [720, 0],
      "credentials": { "magicHourApi": { "id": "REPLACE", "name": "Magic Hour API" } }
    },
    {
      "parameters": {
        "operation": "download",
        "url": "={{ $json.outputUrl }}"
      },
      "id": "dl",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "name": "={{ $('Product Sheet').item.json.product_id }}_product.mp4",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "list", "value": "root" }
      },
      "id": "drive",
      "name": "Save to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1200, 0]
    }
  ],
  "connections": {
    "When clicking ‘Test workflow’": { "main": [[{ "node": "Product Sheet", "type": "main", "index": 0 }]] },
    "Product Sheet": { "main": [[{ "node": "Fetch Product Image", "type": "main", "index": 0 }]] },
    "Fetch Product Image": { "main": [[{ "node": "Magic Hour I2V", "type": "main", "index": 0 }]] },
    "Magic Hour I2V": { "main": [[{ "node": "Download Video", "type": "main", "index": 0 }]] },
    "Download Video": { "main": [[{ "node": "Save to Drive", "type": "main", "index": 0 }]] }
  }
}
